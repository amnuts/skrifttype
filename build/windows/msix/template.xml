<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="skrifttype.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Andrew Collington\Skrifttype">
    </Installer>
    <PackageInformation
        PackageName="Skrifttype"
        PackageDisplayName="Skrifttype"
        PublisherName="CN=Andrew Collington"
        PublisherDisplayName="Andrew Collington"
        Version="0.0.0.0"
        PackageDescription="A local-first font library that activates fonts on demand">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.amnuts.skrifttype"
                Description="A local-first font library that activates fonts on demand"
                DisplayName="Skrifttype"
                ExecutableName="skrifttype.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Skrifttype</DisplayName>
            <PublisherDisplayName>Andrew Collington</PublisherDisplayName>
            <Description>A local-first font library that activates fonts on demand</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="skrifttype.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
